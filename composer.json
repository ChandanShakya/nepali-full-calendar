{
    "name": "nepaliayush/nepali-full-calendar",
    "description": "A beautiful and feature-rich Nepali calendar component for Laravel with Livewire support",
    "type": "library",
    "keywords": [
        "laravel",
        "livewire",
        "nepali",
        "calendar",
        "nepal",
        "bs",
        "bikram-sambat"
    ],
    "homepage": "https://github.com/nepaliayush/nepali-full-calendar",
    "license": "MIT",
    "authors": [
        {
            "name": "Ayush Nepali",
            "email": "your@email.com",
            "homepage": "https://github.com/nepaliayush",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "anuzpandey/laravel-nepali-date": "^2.3",
        "illuminate/support": "^10.0|^11.0",
        "livewire/livewire": "^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Nepaliayush\\NepaliFullCalendar\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nepaliayush\\NepaliFullCalendar\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nepaliayush\\NepaliFullCalendar\\NepaliFullCalendarServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    }
}
